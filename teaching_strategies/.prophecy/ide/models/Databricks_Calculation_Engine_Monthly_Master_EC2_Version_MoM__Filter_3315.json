      "component" : "Reformat",
      "metadata" : {
        "label" : "Formula_3309_to_Formula_3314_1",
        "x" : 860,
        "y" : 120,
        "phase" : 0,
        "comment" : "Calculates refined financial projections from contract terms and term-based conversions while preparing renewal and product data for next-year forecasting.",
        "autoUpdateComment" : true
      },
      "properties" : {
        "columnsSelector" : [ "HtS4yj2hGilyK74wT5m6Q##ContractTermDays", "HtS4yj2hGilyK74wT5m6Q##TCV", "HtS4yj2hGilyK74wT5m6Q##Expected Renewal Date", "HtS4yj2hGilyK74wT5m6Q##Product Code", "HtS4yj2hGilyK74wT5m6Q##ContractStartDate" ],
        "expressions" : [ {
          "expression" : {
            "expression" : "CAST((CASE WHEN (ContractTermDays <= 0) THEN 0 ELSE ((CASE WHEN (((((TCV / ContractTermDays) * 365.25) / 0.01) < 0) AND (((((TCV / ContractTermDays) * 365.25) / 0.01) - FLOOR((((TCV / ContractTermDays) * 365.25) / 0.01))) = 0.5)) THEN CEIL((((TCV / ContractTermDays) * 365.25) / 0.01)) ELSE ROUND((((TCV / ContractTermDays) * 365.25) / 0.01)) END) * 0.01) END) AS DOUBLE)"
          },
          "alias" : "ARR",
          "_row_id" : "591xQdjsGoKpGP-tX5MD0"
        }, {
          "expression" : {
            "expression" : "CAST(((CASE WHEN ((((ContractTermDays / 30.4375) / 0.1) < 0) AND ((((ContractTermDays / 30.4375) / 0.1) - FLOOR(((ContractTermDays / 30.4375) / 0.1))) = 0.5)) THEN CEIL(((ContractTermDays / 30.4375) / 0.1)) ELSE ROUND(((ContractTermDays / 30.4375) / 0.1)) END) * 0.1) AS DOUBLE)"
          },
          "alias" : "ContractTermMonths",
          "_row_id" : "j3eeGltrSQpKeegMil7my"
        }, {
          "expression" : {
            "expression" : "CAST((SUBSTRING( CAST(`Expected Renewal Date` AS string), 1, 4)) AS string)"
          },
          "alias" : "`Expected Year Renewals`",
          "_row_id" : "sjOR9nsHn0ATsJ7qDArSj"
        }, {
          "expression" : {
            "expression" : "CAST(UPPER(`Product Code`) AS string)"
          },
          "alias" : "`Product Code`",
          "_row_id" : "SkMRvjsJBaXC0OEaD-iQf"
        }, {
          "expression" : {
            "expression" : "CAST((SUBSTRING( CAST(ContractStartDate AS string), 1, 4)) AS string)"
          },
          "alias" : "`Expected Year Renewals Quote`",
          "_row_id" : "Cb3Doh5ws885tmDjA5Ohu"
        }, {
          "expression" : {
            "expression" : "'1'"
          },
          "alias" : "`Next Year`",
          "_row_id" : "BTRTd8XnIL"
        }, {
          "expression" : {
            "expression" : "* EXCEPT(`product code`)"
          },
